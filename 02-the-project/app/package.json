{
  "name": "potato-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "audit": "bash ../../04-audit-scripts/run-all.sh",
    "check:intelligence": "esbuild scripts/intelligence.check.ts --bundle --platform=node --format=esm --outfile=.tmp/intel.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/intel.mjs",
    "check:voice": "esbuild scripts/voice.check.ts --bundle --platform=node --format=esm --outfile=.tmp/voice.mjs --external:@prisma/client --log-level=warning && node .tmp/voice.mjs",
    "check:autonomy": "esbuild scripts/autonomy.check.ts --bundle --platform=node --format=esm --outfile=.tmp/aut.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/aut.mjs",
    "check:load": "esbuild scripts/load.check.ts --bundle --platform=node --format=esm --outfile=.tmp/load.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/load.mjs",
    "check:search": "esbuild scripts/search.check.ts --bundle --platform=node --format=esm --outfile=.tmp/search.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/search.mjs",
    "check:buyers": "esbuild scripts/buyers.check.ts --bundle --platform=node --format=esm --outfile=.tmp/buyers.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/buyers.mjs",
    "check:deals": "esbuild scripts/deals.check.ts --bundle --platform=node --format=esm --outfile=.tmp/deals.mjs --external:@prisma/client --log-level=warning && node .tmp/deals.mjs",
    "check:intake": "esbuild scripts/intake.check.ts --bundle --platform=node --format=esm --outfile=.tmp/intake.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/intake.mjs",
    "check:sigv4": "esbuild scripts/sigv4.check.ts --bundle --platform=node --format=esm --outfile=.tmp/sigv4.mjs --log-level=warning && node .tmp/sigv4.mjs",
    "check:storage": "esbuild scripts/storage.check.ts --bundle --platform=node --format=esm --outfile=.tmp/storage.mjs --external:@prisma/client --log-level=warning && node .tmp/storage.mjs",
    "check:tenancy": "esbuild scripts/tenant-isolation.check.ts --bundle --platform=node --format=esm --outfile=.tmp/tenancy.mjs --external:@prisma/client --log-level=warning && node --env-file-if-exists=.env .tmp/tenancy.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
