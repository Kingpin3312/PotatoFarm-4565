# ============================================================
# PotatoFarm.io — environment
#
# Copy to .env.local for development. Set the same keys in Vercel,
# separately for preview and production.
#
# **Every variable below is read by the code.** It used to carry twenty
# that were not — Sanity, Turnstile, Upstash, a CRM endpoint, Google
# Analytics — inherited from a marketing site in 99-superseded that this
# application has never been. Dead configuration is worse than none: it
# invites somebody to provision services the product does not use, and it
# hides the handful that genuinely matter.
#
# Anything absent from this file and present in the code is a bug. There
# is a check for that in 04-audit-scripts.
# ============================================================

# ---- Database ----
# The application's own connection. In production this must be a role
# that does NOT own the tables and does NOT have BYPASSRLS, or row-level
# security enforces nothing. See src/server/db/rls.sql.
#
# ** PUT A POOLER IN FRONT OF THIS. **
#
# Not a preference. Every serverless function instance opens its own
# Prisma connection pool, and there are 24 cron jobs that can fire at
# the same minute. Postgres defaults to 100 connections total and a
# managed instance often gives fewer. The failure is not gradual: it is
# `FATAL: sorry, too many clients already` on the first busy afternoon,
# which looks to a brokerage like the product falling over at exactly
# the moment they were using it properly.
#
# Neon, Supabase and Vercel Postgres all publish a separate pooled URL —
# use that one here. On plain Postgres, PgBouncer in transaction mode.
# Either way append:
#
#   ?pgbouncer=true&connection_limit=1
#
# `connection_limit=1` is right for serverless specifically: the pooler
# is doing the pooling, so each function wants one connection rather
# than a pool of its own. Prisma also needs `pgbouncer=true` to stop
# using prepared statements, which transaction-mode pooling breaks.
#
# **In production this MUST point at a connection pooler**, not at
# Postgres directly. Every serverless invocation opens its own
# connection, twenty-five crons open more, and `forOrg()` opens a
# transaction per query on top; Postgres runs out of connections long
# before it runs out of capacity. The load check measured the shape of
# it — the slowest first call is connection setup, not query time.
#
# Supabase/Neon give you a pooler host on :6543, PgBouncer wants
# `?pgbouncer=true`, Prisma Accelerate is a prisma:// URL. Whichever you
# use, `check:preflight` asserts it and refuses a bare connection.
DATABASE_URL=

# The same database, NOT through the pooler. Used only by
# `prisma migrate` and `prisma db push`.
#
# A transaction-mode pooler hands each statement a different backend,
# and a migration needs advisory locks and DDL that must all land on
# one — including the RLS policies in rls.sql, where getting half of
# them applied is the worst outcome available.
#
# REQUIRED, and Prisma has no fallback for it.
#
# ** It must be the OWNING role, not DATABASE_URL. **
#
# This line used to say "in development, set it to the same string as
# DATABASE_URL", and that advice does not work — it produces:
#
#     Database error code: 42501
#     ERROR: must be owner of table Lead
#
# on the first `prisma migrate deploy`. DATABASE_URL is deliberately a
# role that does not own the tables, because that is what makes RLS
# enforceable. A role that cannot own a table also cannot ALTER one, so
# it cannot run a migration.
#
# Use the same role as DATABASE_URL_UNSCOPED below (the owner), and
# without the pooler. In development that is the whole difference:
#
#   DATABASE_URL          potato_app    restricted, what the app uses
#   DATABASE_URL_DIRECT   potato_owner  owns the tables, migrations only
#   DATABASE_URL_UNSCOPED potato_owner  owner + BYPASSRLS, crossTenant()
DATABASE_URL_DIRECT=

# The privileged connection, for the queries that are legitimately
# cross-tenant: sign-in, organisation creation, the webhooks and every
# scheduled sweep. Reached only through `crossTenant(reason)`.
#
# REQUIRED IN PRODUCTION. If it is unset the application falls back to
# DATABASE_URL and logs a warning — and if that role owns the tables,
# RLS is decorative. Without it, sign-in cannot read Membership and
# nobody can get into the product at all.
#
# **The role here needs BYPASSRLS. Owning the tables is not enough.**
# rls.sql sets FORCE ROW LEVEL SECURITY, which applies the policies to
# the table owner as well — that is deliberate, because otherwise
# anybody who connects as the owner walks straight through the tenant
# boundary. The consequence is that the owner cannot do the
# cross-tenant work either. Found by running the tenancy check against
# an owner role: `new row violates row-level security policy for table
# "Organisation"`, which is sign-up failing for every new customer.
#
#   ALTER ROLE potato_root WITH BYPASSRLS;
#
# On a managed Postgres where you cannot grant BYPASSRLS (some hosted
# tiers forbid it), the alternative is to drop FORCE and use the table
# owner — weaker, and a deliberate decision rather than a default.
DATABASE_URL_UNSCOPED=

# ---- Authentication ----
# REQUIRED. NextAuth v5 will not start in production without it, and
# there is no default. Every session cookie is signed with this, so
# changing it signs everybody out.
#
#   openssl rand -base64 32
#
AUTH_SECRET=

# Only needed behind a proxy that rewrites the host. Vercel sets what it
# needs on its own.
# AUTH_URL=https://app.potatofarm.io

# ---- App ----
NEXT_PUBLIC_APP_URL=https://app.potatofarm.io

# ---- The assistant ----
ANTHROPIC_API_KEY=
# Optional. Check the model id against current availability before
# setting it — the default in controls.ts is a guess and the price table
# beside it is a guess too.
ASSISTANT_MODEL=

# ---- Email (Resend) ----
# Sign-in is a one-time link to a work email, so **email delivery is the
# only way into the product**. Verify the sending domain properly: an
# unverified sender puts every sign-in link in a junk folder and the
# failure looks like the application being broken.
RESEND_API_KEY=
MAIL_FROM="PotatoFarm.io <hello@potatofarm.io>"

# Where a demo request from the marketing site is emailed. Optional —
# it falls back to hello@potatofarm.io. Set it if sales and support are
# read by different people.
SALES_INBOX=

# ---- WhatsApp Business Platform ----
# VERIFY_TOKEN is any string you choose; it must match what you enter in
# Meta's webhook setup. APP_SECRET signs the webhooks — without it,
# anyone who finds the URL can write messages into a brokerage's inbox.
#
# In development APP_SECRET may be any string at all: `check:whatsapp-inbound`
# uses it to sign its own fake delivery, so the two ends match whatever it
# is. Leaving it empty does not fail that check — it skips it, which is
# how the one end-to-end proof that an inbound message becomes a lead
# went unrun. Set it locally even with nothing connected.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Facebook and Instagram lead ads ----
# The channel a Dubai brokerage often spends most on, and the only lead
# source here with a documented, permitted API — the property portals
# have none, and the public "APIs" for them are scrapers that get your
# customer's account suspended.
#
# Each brokerage's Page token is stored per-tenant through secrets.ts,
# never here: one shared token means one expiry taking out every
# customer at once.
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---- Channel credentials ----
# `readSecret(ref)` resolves `SECRET_<ref>` from the environment, and
# that is the whole implementation — there is no secrets provider behind
# it yet. Until one is wired up, each connected channel needs its access
# token here under its own reference, for example:
#
#   SECRET_wa_marina_main=EAAG...
#
# See src/server/lib/secrets.ts. Swapping in AWS Secrets Manager, Vault
# or Doppler changes that one file and no call site.

# ---- Speech to text ----
# What makes voice work on an iPhone.
#
# The Speak button used to use the browser's own speech API, which iOS
# Safari does not implement — and every browser on iOS runs on Safari's
# engine, so it worked on a laptop and failed on the phone the product
# is built for. Recording now happens on the device and transcription
# here.
#
# **Any provider with an OpenAI-compatible /audio/transcriptions
# endpoint.** Deliberately not Anthropic: the assistant is Anthropic and
# stays that way, but Anthropic does not transcribe audio.
#
#   OpenAI   leave BASE_URL unset, MODEL whisper-1
#   Groq     https://api.groq.com/openai/v1, whisper-large-v3-turbo
#            — materially cheaper and faster, same API
#   Local    http://whisper.internal:8080/v1 for a self-hosted whisper
#
# Unset, the Speak button falls back to the browser API where one exists
# (Chrome and Edge on a desktop) and says so plainly where none does.
# The rest of the product is unaffected.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_MODEL=

# ---- Object storage ----
# Where an agent's brochures, floor plans and KYC documents live.
#
# Any S3-compatible provider: AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces or a self-hosted MinIO. The application signs its
# own requests (src/server/lib/files/sigv4.ts) rather than carrying an
# SDK, so the difference between providers is the endpoint string.
#
# Unset, file upload throws and says so. It does NOT quietly succeed —
# a row in the attachment library pointing at an object that was never
# written is a brochure that fails in front of a buyer.
#
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   (R2)
#   S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com        (AWS)
#   S3_REGION=auto                                           (R2 uses "auto")
#
# **The bucket must not be public.** The send path reads the bytes and
# pushes them to Meta rather than handing out a URL, precisely so no
# brochure is left on an unauthenticated endpoint. Keys are
# `org/<orgId>/files/<uuid>`, so a bucket policy scoped by prefix keeps
# one brokerage out of another's files even if this application is wrong.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave unset. Path style is assumed for everything except AWS, which is
# what each provider's own documentation does. Set "true" or "false" only
# if your provider disagrees — the symptom is a 404 that reads like a
# missing bucket rather than an auth error.
# S3_FORCE_PATH_STYLE=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Scheduled jobs ----
# Bearer token on /api/cron/*. Without it the endpoint refuses to run at
# all — deliberately, because an open invoicing endpoint is a way for
# anyone who finds it to bill every customer again.
CRON_SECRET=

# ---- Price ----
# Priced in USD, invoiced in AED.
#
# The headline is $70 per agent per month. The invoice is AED, because
# UAE VAT is levied in dirhams and a tax invoice in another currency is
# one an accountant sends back.
#
# The dirham is pegged to the dollar at 3.6725 and has been since 1997,
# so the two never drift and no conversion is ever needed at runtime.
# 25708 fils = AED 257.08 = exactly $70.
#
# `signup` refuses to run if this is unset. No default.
SEAT_PRICE_FILS=25708

# ------------------------------------------------------------
# The conversation allowance — 60 included per seat, 35 fils each
# beyond — is real and is charged, but it is held on the Subscription
# row (`includedPerSeat`, `overageFils`) rather than in the environment.
# It used to be listed here as if it were configuration and nothing ever
# read it, which is how somebody ends up changing a number that has no
# effect.
# ------------------------------------------------------------

# ---------------------------------------------------------------------
# The key that seals every stored token.
#
# WhatsApp access tokens, mailbox tokens and portal credentials are
# encrypted with this before they reach Postgres, so a database dump
# carries nothing able to message a customer's clients. Without it,
# nothing can be connected — the connect form refuses the token rather
# than storing it in the clear.
#
#   openssl rand -base64 32
#
# Losing it means every connected channel and mailbox has to be
# reconnected. It is the one value here worth backing up somewhere a
# database restore cannot reach.
SECRETS_KEY=""

# ---- Alerting and the dead-man's switch ----
# The health sweep classifies every incident PAGE / TICKET / LOG,
# attaches a runbook and deduplicates — and until this was added its
# last step was writing to stdout. A stopped cron raised a PAGE and
# nobody was ever paged.
#
# ALERT_WEBHOOK_URL takes any endpoint that accepts a JSON POST: a Slack
# incoming webhook, a PagerDuty Events v2 URL, Opsgenie, or your own.
# The payload carries `text`, `payload.summary` and a structured
# `alert`, so it fits all three without adapting.
ALERT_WEBHOOK_URL=
#
# HEARTBEAT_URL is pinged after each SUCCESSFUL health sweep, and it is
# the only alarm that survives the outage it reports. Everything else
# runs inside this application: if the deployment is down or the crons
# have stopped, the code that would notice has also stopped. An external
# service that alarms when the ping *stops* does not share that failure
# domain. Healthchecks.io, Better Stack, Cronitor and Dead Man's Snitch
# all take a bare GET.
HEARTBEAT_URL=

# ---- Object storage: path style ----
# Set to "true" for MinIO, Backblaze B2 and most self-hosted S3
# implementations, which address buckets as a path rather than a
# subdomain. AWS and Cloudflare R2 do not need it.
S3_FORCE_PATH_STYLE=

# ---- Voice transcription, non-default endpoints ----
# Both optional. Set BASE_URL to point at a self-hosted or regional
# transcription endpoint, and MODEL to override the default model.
# Leaving them empty uses the provider's defaults.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=

# Set to 1 only if `DATABASE_URL` goes through a pooler whose hostname
# `check:preflight` does not recognise.
#
# An override for a regex that cannot know every provider's naming, not
# a way to pass the check. A direct connection will exhaust Postgres on
# the first busy day, and the scheduled jobs are what will find out.
POOLER_CONFIRMED=
