# ============================================================
# PotatoFarm.io — environment
# Copy to .env.local for development. Set the same keys in
# Vercel for preview and production separately.
# ============================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://potatofarm.io

# ---- CMS (Sanity) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=            # server only. Never prefix this NEXT_PUBLIC_
SANITY_REVALIDATE_SECRET=         # must match the webhook in Sanity

# ---- Email (Resend) ----
RESEND_API_KEY=
MAIL_FROM="PotatoFarm.io <hello@potatofarm.io>"
SALES_INBOX=hello@potatofarm.io

# ---- Spam (Cloudflare Turnstile) ----
# REQUIRED IN PRODUCTION. If TURNSTILE_SECRET_KEY is empty the captcha
# check is skipped and only a warning is logged — the site will look
# completely fine while having no spam protection at all.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Rate limiting ----
# Without these, limiting is per-instance and only slows an attacker down.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- CRM & webhooks ----
CRM_ENDPOINT=
CRM_API_KEY=
LEAD_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=

# ---- Analytics ----
# Loads only after consent. See src/components/consent.tsx
NEXT_PUBLIC_GA_ID=

# ============================================================
# CRM — added after an audit found these being read in code
# with nothing telling anyone to set them. Each one is a
# silent runtime failure on deploy.
# ============================================================

# ---- Database ----
DATABASE_URL=

# ---- App ----
NEXT_PUBLIC_APP_URL=https://app.potatofarm.io

# ---- Authentication ----
# REQUIRED. NextAuth v5 refuses to start in production without it, and
# there is no default — every session cookie is signed with this, so
# changing it signs everybody out.
#
#   openssl rand -base64 32
#
AUTH_SECRET=
#
# Only needed if the app is behind a proxy that rewrites the host, or
# running somewhere the deployment URL cannot be inferred. Vercel sets
# what is needed on its own.
# AUTH_URL=https://app.potatofarm.io

# ---- The assistant ----
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ASSISTANT_MODEL=

# ---- WhatsApp Business Platform ----
# VERIFY_TOKEN is any string you choose; it must match what you enter in
# Meta's webhook setup. APP_SECRET signs the webhooks — without it, anyone
# who finds the URL can write messages into a brokerage's inbox.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Scheduled jobs ----
# Bearer token on /api/cron/*. Without it the endpoint refuses to run at
# all — deliberately, because an open invoicing endpoint is a way for
# anyone who finds it to bill every customer again.
CRON_SECRET=

# ---- Price ----
# Priced in USD, invoiced in AED.
#
# The headline is $70 per agent per month. The invoice is AED, because
# UAE VAT is levied in dirhams and a tax invoice in another currency is
# one an accountant sends back.
#
# The dirham is pegged to the dollar at 3.6725 and has been since 1997,
# so the two never drift and no conversion is ever needed at runtime.
# 25708 fils = AED 257.08 = exactly $70.
#
# signup refuses to run if SEAT_PRICE_FILS is unset. No default.
SEAT_PRICE_FILS=25708

# Answered conversations included per agent per month, and the price of
# one beyond that. 35 fils = AED 0.35, about $0.095.
#
# Per-seat alone charged by headcount and delivered value by
# conversation, and in this market those are not correlated: a
# lead-heavy 8-agent firm ran at 31% gross margin while a quiet
# 40-agent firm ran at 90%. The small one was subsidising the large.
#
# The headline price did not change. Only firms past the allowance pay
# more, so no published quote was invalidated and no bill went down.
SEAT_INCLUDED_CONVERSATIONS=60
CONVERSATION_OVERAGE_FILS=35
SEAT_PRICE_USD=70
AED_PER_USD=3.6725

# ---- Facebook and Instagram lead ads ----
# The channel a Dubai brokerage often spends most on, and the only lead
# source here with a documented, permitted API — the property portals
# have none, and the public "APIs" for them are scrapers that get your
# customer's account suspended.
#
# META_APP_SECRET signs the webhook. META_VERIFY_TOKEN is any string you
# choose; Meta echoes it once during the subscription handshake.
#
# Each brokerage's Page token is stored per-tenant via secrets.ts, never
# here — one shared token would mean one expiry taking out every
# customer at once.
META_APP_SECRET=
META_VERIFY_TOKEN=
