// Potato CRM — data model
//
// Two decisions shape everything below.
//
// 1. Every tenant-owned row carries `orgId`, and Postgres row-level
//    security enforces it. Application-level filtering alone means one
//    forgotten `where` clause leaks another brokerage's client list. The
//    security page promises this does not happen; RLS is what makes that
//    promise true rather than aspirational. See src/server/db/rls.sql.
//
// 2. WhatsApp is not email. Meta's Business Platform only lets you send
//    freely inside a 24-hour window from the customer's last inbound
//    message. Outside it you need a pre-approved template. That constraint
//    is in the model (`lastInboundAt`), not left for someone to discover
//    in production when the follow-ups stop sending.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- tenancy

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Dubai")
  currency  String   @default("AED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete. A brokerage that leaves must be recoverable for the
  // retention period, then hard-deleted on a schedule.
  deletedAt DateTime?

  memberships   Membership[]
  invitations   Invitation[]
  leads         Lead[]
  listings      Listing[]
  conversations Conversation[]
  viewings      Viewing[]
  channels      Channel[]
  profiles      QualificationProfile[]
  stages        PipelineStage[]
  workingHours  WorkingHours[]
  assistant     AssistantSettings?
  assistantUsage AssistantUsage[]
  auditLogs     AuditLog[]

  @@index([deletedAt])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?

  memberships   Membership[]
  assignedLeads Lead[]       @relation("AssignedAgent")
  viewings      Viewing[]
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]
}

/// A user's place in one brokerage. Users can belong to several — agents
/// move between agencies constantly in this market, and a model that
/// assumes one org per user forces them to keep two logins.
model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
}

/// How much of the team's numbers each agent can see.
///
/// The first agent test: *"if I can see my own numbers before my manager
/// does, it's a tool. If he sees them first, it's surveillance."* This
/// is the setting that decides which one it is, and the default matters
/// more than the option.
enum VisibilityMode {
  /// Everyone sees the full board. Agents are competitive and most
  /// brokerages land here — but it should be a decision, not a default.
  OPEN
  /// You see your own figures and where you rank, not everyone else's.
  /// The default: enough to compete, not enough to humiliate.
  RANKED
  /// Your own figures only. For a brokerage that has been burned.
  PRIVATE
}

enum Role {
  OWNER   // billing, deletion, everything
  ADMIN   // settings, members, all leads
  MANAGER // all leads in the org, no billing
  AGENT   // own leads only
  VIEWER  // read only — for accountants and auditors

  /// Required by UAE AML law: every DNFBP appoints one. Deliberately not
  /// a superset of ADMIN — a compliance officer sees the AML file and the
  /// reports, and does not need to be able to change billing or delete
  /// the organisation. Separating them is the point.
  COMPLIANCE_OFFICER
}

model Invitation {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role      @default(AGENT)
  /// SHA-256 of the token, never the token itself. The plaintext exists
  /// only in the email that was sent. Storing it means read access to the
  /// database is enough to join any brokerage.
  tokenHash  String    @unique
  expiresAt  DateTime
  invitedById String?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
}

// ---------------------------------------------------------------- leads

model Lead {
  id       String @id @default(cuid())
  orgId    String
  /// E.164. This is the identity in a WhatsApp-first product — not email.
  phone    String
  name     String?
  email    String?
  language String @default("en")

  /// Coarse, system-owned state. Drives automation and reporting, and is
  /// the same in every brokerage so cross-org benchmarks mean something.
  status  LeadStatus @default(NEW)

  /// The brokerage's own board column. Configurable, because a rental
  /// team and an off-plan team do not run the same pipeline.
  stageId String?
  /// Fractional index for ordering within a column, as an unbounded
  /// Postgres NUMERIC. A plain integer would mean rewriting every row
  /// below it on every drag; halving a NUMERIC is exact and never runs
  /// out of precision. The midpoint is computed in SQL, never in JS —
  /// see routers/pipeline.ts.
  position Decimal @default(0) @db.Decimal
  /// When it entered the current column. This is what makes "sitting
  /// untouched for nine days" answerable without a full history scan.
  stageEnteredAt DateTime @default(now())

  score   Int?
  source  LeadSource @default(UNKNOWN)

  // Qualification results, captured by the assistant.
  /// Fils, not AED. Every money value in this schema is fils — see the
  /// note on Money below. Two units for one quantity is how a match ends
  /// up out by a factor of a hundred.
  budgetMinFils BigInt?
  budgetMaxFils BigInt?
  intent     Intent?
  timeframe  String?
  financing  String?
  notes      String?

  assignedToId String?
  assignedAt   DateTime?

  /// UAE residency visa expiry, if the buyer has ever mentioned it.
  ///
  /// Never asked for directly — an agent hears it in passing ("my visa
  /// renews in March, I want to be settled before then") and there was
  /// nowhere to put it. A resident deciding whether to renew is a
  /// resident deciding whether to buy, and it is a real trigger nobody
  /// else in this market uses.
  ///
  /// A date of birth, not a government ID number or a scan — see
  /// PRIVACY.md in this folder for why the distinction matters here.
  visaExpiresAt DateTime?
  /// The last time a visa nudge went out, so the sweep does not repeat
  /// itself every day once inside the window.
  visaNudgedAt  DateTime?

  // Attribution. Carried from the enquiry so reporting can answer "what
  // does a Bayut lead actually cost us" without a spreadsheet.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// Proactive outbound. Separate from the conversation: somebody who
  /// says stop to property alerts still expects a reply when they ask a
  /// question, and conflating the two is how you either spam them or go
  /// silent on a live enquiry.
  optedOutOfOutreach Boolean   @default(false)
  optedOutAt         DateTime?
  lastOutreachAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org          Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stageRef     PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  conversation Conversation?
  enquiries    Enquiry[]
  viewings     Viewing[]
  answers      Answer[]

  /// One lead per phone number per brokerage. The same person enquiring
  /// with two agencies is two leads; enquiring twice with one is one.
  @@unique([orgId, phone])
  @@index([orgId, status])
  @@index([orgId, assignedToId])
  @@index([orgId, createdAt])
  /// Covers the board query: one column, ordered, paginated.
  @@index([orgId, stageId, position])
  @@index([orgId, stageId, stageEnteredAt])
}

/// A column on the board. Owned by the brokerage.
model PipelineStage {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  position Int
  /// Which system status a lead takes when it lands here. Keeps the
  /// configurable board tied to the fixed reporting model.
  maps     LeadStatus
  /// Days before a lead in this column is flagged as going cold. Null
  /// means never — appropriate for Won and Lost, not for anything else.
  staleAfterDays Int?
  isWon    Boolean @default(false)
  isLost   Boolean @default(false)
  archived Boolean @default(false)

  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@unique([orgId, name])
  @@index([orgId, position])
}

enum LeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  VIEWING_BOOKED
  NEGOTIATING
  WON
  LOST
  UNRESPONSIVE
}

enum LeadSource {
  PROPERTY_FINDER
  BAYUT
  DUBIZZLE
  WEBSITE
  WHATSAPP_AD
  REFERRAL
  WALK_IN
  UNKNOWN
}

enum Intent {
  BUY_TO_LIVE
  BUY_TO_INVEST
  RENT
  SELL
  LIST
}

// ------------------------------------------------------------ messaging

model Conversation {
  id     String @id @default(cuid())
  orgId  String
  leadId String @unique

  channelId String

  /// The 24-hour clock. Meta only allows free-form messages within 24
  /// hours of this timestamp; after that a pre-approved template is the
  /// only way to reopen the thread. Every send path checks it.
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  /// Set when a lead asks for a person, or a rule escalates. While true
  /// the assistant does not send anything.
  humanHandover   Boolean   @default(false)
  handoverAt      DateTime?
  handoverReason  String?

  unreadCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead     Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel  Channel      @relation(fields: [channelId], references: [id])
  messages Message[]

  @@index([orgId, updatedAt])
  @@index([orgId, humanHandover])
}

model Message {
  id             String    @id @default(cuid())
  orgId          String
  conversationId String

  direction Direction
  /// Who actually sent it. A lead can tell the difference and so should
  /// the audit trail.
  author    Author
  authorId  String?

  body        String
  mediaUrl    String?
  templateName String?

  /// Meta's message id. Unique so a redelivered webhook cannot double-write.
  externalId String?       @unique
  status     MessageStatus @default(PENDING)
  failure    String?

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId, conversationId, sentAt])
}

enum Direction { INBOUND OUTBOUND }
enum Author    { LEAD ASSISTANT AGENT SYSTEM }
enum MessageStatus { PENDING SENT DELIVERED READ FAILED }

// ------------------------------------------------------------- channels

/// A connected WhatsApp number or portal feed. Credentials are never
/// stored here in plaintext — `secretRef` points at the secrets manager.
model Channel {
  id        String      @id @default(cuid())
  orgId     String
  type      ChannelType
  label     String
  /// WhatsApp: the display number. Portal: the account identifier.
  identifier String
  secretRef  String?
  active     Boolean    @default(true)
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime   @default(now())

  org           Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  enquiries     Enquiry[]

  @@unique([orgId, type, identifier])
  @@index([orgId, active])
}

enum ChannelType {
  WHATSAPP
  PROPERTY_FINDER
  BAYUT
  DUBIZZLE
  WEBSITE_FORM
}

// ------------------------------------------------------------- listings

model Listing {
  id        String  @id @default(cuid())
  orgId     String
  reference String
  title     String
  community String?
  building  String?
  bedrooms  Int?
  bathrooms Int?
  areaSqft  Int?
  /// Fils. See the note on Money.
  priceFils BigInt?
  purpose   Purpose  @default(SALE)
  status    ListingStatus @default(AVAILABLE)

  /// Dubai requires a Trakheesi permit number on every property
  /// advertisement. Portals reject listings without one, and advertising
  /// without a valid permit is a fineable offence for the brokerage — so
  /// this is validated before publish, not after rejection.
  /// Who instructed us. Optional because a listing can be entered
  /// before the paperwork lands — but publishing without one should be
  /// a question rather than a surprise.
  vendorId  String?

  permitNumber    String?
  permitExpiresAt DateTime?
  /// The RERA card of the agent the listing is advertised under.
  reraBrokerCard  String?

  /// Description and title in each language the brokerage advertises in.
  /// Portals reject an Arabic listing with an English-only description.
  descriptions Json?

  publications ListingPublication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enquiries Enquiry[]
  viewings  Viewing[]

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@index([orgId, permitExpiresAt])
}

/// One row per listing per portal. Separate from the listing because the
/// same property can be live on Bayut, rejected by Property Finder and
/// still draft on the website — and a single JSON blob makes that state
/// impossible to query, alert on, or fix.
model ListingPublication {
  id        String  @id @default(cuid())
  orgId     String
  listingId String
  channelId String

  state       PublishState @default(PENDING)
  /// The portal's own id, once it has accepted the listing.
  externalId  String?
  /// Why it was rejected, in the portal's words. Kept verbatim — a
  /// paraphrased rejection reason is useless to whoever has to fix it.
  rejection   String?
  publishedAt DateTime?
  lastTriedAt DateTime?
  attempts    Int      @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, channelId])
  @@index([orgId, state])
}

enum PublishState {
  PENDING     // queued, not yet sent
  PUBLISHED   // live on the portal
  REJECTED    // portal refused it — see rejection
  WITHDRAWN   // pulled on purpose
  FAILED      // transport failure, will retry
}

enum Purpose { SALE RENT }
enum ListingStatus { DRAFT AVAILABLE UNDER_OFFER SOLD LET WITHDRAWN }

/// A lead asking about a specific listing. One lead can enquire on several
/// properties; the join carries which channel it arrived through, which is
/// what makes cost-per-lead reporting possible.
model Enquiry {
  id        String   @id @default(cuid())
  orgId     String
  leadId    String
  listingId String?
  channelId String
  /// The portal's own id. Unique per brokerage so a redelivered webhook
  /// cannot become a second enquiry on the board.
  externalId String?
  message   String?
  createdAt DateTime @default(now())

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  channel Channel  @relation(fields: [channelId], references: [id])

  @@unique([orgId, externalId])
  @@index([orgId, leadId])
  @@index([orgId, createdAt])
  @@index([channelId, createdAt])
}

// ------------------------------------------------------------- viewings

model Viewing {
  id        String        @id @default(cuid())
  orgId     String
  leadId    String
  listingId String?
  agentId   String?
  scheduledAt DateTime
  durationMins Int         @default(30)
  /// Generated column holding [scheduledAt, scheduledAt + duration). The
  /// exclusion constraint in scheduling.sql is built on this — it is what
  /// makes a double booking impossible rather than merely unlikely.
  /// Managed by SQL; Prisma only reads it.
  timespan  Unsupported("tstzrange")?
  /// Where it actually is.
  ///
  /// Denormalised from the listing on purpose. A listing can be edited
  /// or unpublished between booking and attending, and an agent standing
  /// outside the wrong tower does not care which record was correct.
  /// Marina alone has six towers with nearly the same name.
  address   String?
  building  String?
  /// For a maps link. Null is fine — the address still opens a search.
  lat       Float?
  lng       Float?
  /// Which entrance, which floor, where to park. The things a colleague
  /// tells you on the phone and nobody writes down.
  accessNote String?

  status    ViewingStatus  @default(SCHEDULED)
  outcome   String?

  /// Slots the assistant has offered but nobody has accepted yet. Without
  /// a hold, two leads offered the same 10:00 both take it.
  heldUntil DateTime?

  /// Reminder state. Nulls mean not yet sent; this is what stops a retry
  /// sending the same reminder twice.
  remindedLeadAt  DateTime?
  remindedAgentAt DateTime?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead    Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  listing Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  agent   User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([orgId, scheduledAt])
  @@index([orgId, agentId, scheduledAt])
  @@index([orgId, status, scheduledAt])
}

/// Working hours per brokerage. Not a constant, because the UAE working
/// week is not the Monday-to-Friday one most scheduling code assumes —
/// agents in this market do most of their viewings at the weekend.
model WorkingHours {
  id        String @id @default(cuid())
  orgId     String
  /// 0 = Sunday, matching Postgres DOW.
  dayOfWeek Int
  /// Minutes from midnight, in the brokerage's own timezone.
  startMin  Int
  endMin    Int
  closed    Boolean @default(false)

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, dayOfWeek])
}

enum ViewingStatus { SCHEDULED CONFIRMED COMPLETED NO_SHOW CANCELLED }

// -------------------------------------------------------- qualification

/// The questions the assistant asks. Owned by the brokerage, versioned,
/// because changing them mid-campaign otherwise rewrites history.
model QualificationProfile {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  version   Int      @default(1)
  active    Boolean  @default(false)
  tone      String?
  languages String[] @default(["en", "ar"])
  createdAt DateTime @default(now())

  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  questions Question[]
  answers   Answer[]

  @@unique([orgId, name, version])
  @@index([orgId, active])
}

model Question {
  id        String       @id @default(cuid())
  profileId String
  order     Int
  key       String
  prompt    String
  type      QuestionType @default(TEXT)
  options   String[]
  required  Boolean      @default(true)

  profile QualificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([profileId, key])
}

enum QuestionType { TEXT NUMBER MONEY CHOICE DATE BOOLEAN }

model Answer {
  id         String   @id @default(cuid())
  orgId      String
  leadId     String
  questionId String
  profileId  String
  value      String
  /// The assistant's confidence. Anything low gets flagged for an agent
  /// rather than silently written into the pipeline as fact.
  confidence Float?
  createdAt  DateTime @default(now())

  lead     Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  question Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profile  QualificationProfile @relation(fields: [profileId], references: [id])

  @@unique([leadId, questionId])
  @@index([orgId, leadId])
}

// ------------------------------------------------------------ audit log

/// Append only. No update, no delete — enforced by the RLS policy, not by
/// convention. An audit log a developer can quietly edit is not one.
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?
  actorType Author   @default(AGENT)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, entity, entityId])
}

// ------------------------------------------------------------------ auth
// Auth.js adapter tables. No password column anywhere, on purpose: see
// src/server/auth/config.ts.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  /// Which brokerage this session is currently looking at. Held server
  /// side so it cannot be edited by the client, and re-checked against
  /// Membership on every request regardless.
  activeOrgId  String?

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  ip           String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------- assistant controls

/// Per-brokerage control over the assistant. Separate from Organisation so
/// it can be read on its own on every turn without pulling the whole row.
/// Per-brokerage reporting policy.
model TeamVisibility {
  id    String @id @default(cuid())
  orgId String @unique

  mode  VisibilityMode @default(RANKED)

  /// An agent sees their own numbers this many hours before a manager
  /// can. Not a gimmick — it is the difference between "I know I had a
  /// slow week" and "my manager told me I had a slow week", and that
  /// difference decides whether people game the metric.
  agentHeadStartHours Int @default(24)

  updatedAt DateTime @updatedAt
}

model AssistantSettings {
  orgId String @id

  /// The kill switch. False means the assistant sends nothing for this
  /// brokerage, immediately, with no deploy. Read on every single turn.
  enabled       Boolean   @default(false)
  pausedReason  String?
  pausedAt      DateTime?
  pausedById    String?

  /// Hard ceiling on spend per calendar month, in fils to avoid float.
  /// Null means no ceiling — only appropriate for internal test orgs.
  monthlyBudgetFils BigInt?
  /// Warn the brokerage at this fraction of the ceiling.
  warnAtPercent     Int     @default(80)

  /// Which prompt version this brokerage is on. Lets a change roll out to
  /// one customer before all of them.
  promptVersion String @default("current")

  /// Escalate anything above this to a human before the assistant replies.
  handoverAboveBudget Decimal? @db.Decimal(14, 2)

  updatedAt DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Append-only usage ledger. One row per model call, so a bill can be
/// explained rather than merely reported.
model AssistantUsage {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String?
  purpose        String   // "reply" | "extract"
  model          String
  promptVersion  String
  inputTokens    Int
  outputTokens   Int
  /// Cost at the time of the call, in fils. Stored rather than computed
  /// later, because pricing changes and a historical bill must not.
  costFils       BigInt
  latencyMs      Int
  outcome        String   // "sent" | "handover" | "blocked" | "error"
  createdAt      DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// ------------------------------------------------------------ notifying

/// Per person, per brokerage. An agent who works weekends and a manager
/// who does not should not share one setting.
model NotificationPrefs {
  id     String @id @default(cuid())
  orgId  String
  userId String

  push  Boolean @default(true)
  email Boolean @default(false)

  /// Quiet hours in the brokerage's timezone, minutes from midnight.
  /// Null means always available.
  quietFromMin Int?
  quietToMin   Int?
  /// Days off, 0 = Sunday. Agents here often take Monday, not Sunday.
  daysOff      Int[]  @default([])

  /// The one thing that overrides quiet hours. Off by default, because a
  /// setting that wakes someone should be opted into, not out of.
  urgentOverridesQuiet Boolean @default(false)

  @@unique([orgId, userId])
}

/// Sent notifications. Kept so escalation can tell whether the first
/// person was actually told before it starts telling the second.
model Notification {
  id        String  @id @default(cuid())
  orgId     String
  userId    String
  kind      NotificationKind
  /// What it is about, so five enquiries from one lead collapse into one.
  subjectId String
  title     String
  body      String
  deeplink  String

  sentAt     DateTime  @default(now())
  readAt     DateTime?
  actedAt    DateTime?
  /// Which rung of the escalation ladder this was.
  escalation Int       @default(0)
  suppressed String?

  @@unique([orgId, userId, kind, subjectId])
  @@index([orgId, userId, readAt])
  @@index([orgId, kind, subjectId, sentAt])
}

enum NotificationKind {
  HANDOVER_WAITING     // the assistant stepped back and nobody has replied
  QUALIFIED_UNCLAIMED  // a qualified lead with no agent
  VIEWING_TOMORROW
  VIEWING_SOON
  OUTCOME_MISSING      // a viewing happened and nobody said what happened
  PERMIT_EXPIRING
  DEAL_AT_RISK
  PORTAL_SILENT
  ASSISTANT_STOPPED
  /// A personal follow-up the agent set themselves, usually from a
  /// voice note. Theirs, so it goes to them and nobody else.
  FOLLOW_UP_DUE
}

// ----------------------------------------------------------- onboarding

/// Per-brokerage setup state. A row per step rather than a JSON blob, so
/// "how many customers are stuck on WhatsApp verification" is a query
/// rather than an export.
model OnboardingStep {
  id     String @id @default(cuid())
  orgId  String
  key    String

  state      StepState @default(TODO)
  /// Meta's business verification is outside our control and takes days.
  /// A step can be waiting on somebody else without being our problem or
  /// the customer's fault, and the UI needs to say which.
  blockedOn  String?
  note       String?
  startedAt  DateTime?
  doneAt     DateTime?
  doneById   String?

  @@unique([orgId, key])
  @@index([orgId, state])
}

enum StepState {
  TODO
  IN_PROGRESS
  WAITING     // on a third party, not on the customer
  DONE
  SKIPPED
}

// -------------------------------------------------------- support access

/// Time-boxed permission for a named Potato employee to look inside one
/// brokerage. Granted by the customer, never by us.
model SupportGrant {
  id        String @id @default(cuid())
  orgId     String

  /// The employee. A grant is to a person, never to a role or a team —
  /// "support can see your data" is not something a customer can consent
  /// to meaningfully.
  staffEmail String

  /// Read is the default. Write is a separate, explicit decision.
  canWrite   Boolean @default(false)

  reason     String
  /// Who at the brokerage agreed, so consent has a name against it.
  grantedById String
  grantedAt   DateTime @default(now())
  /// Hard ceiling. There is no such thing as an open-ended grant.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  @@index([orgId, expiresAt])
  @@index([staffEmail, expiresAt])
}

// --------------------------------------------------------------- billing

model Subscription {
  id       String @id @default(cuid())
  orgId    String @unique

  plan     String
  /// Fils per seat per month. Stored on the subscription, not looked up
  /// from a price list, so a price change never silently reprices an
  /// existing customer.
  seatPriceFils BigInt

  /// Answered conversations included per agent per month, and the price
  /// of one beyond that.
  ///
  /// Per-seat alone charged by headcount and delivered value by
  /// conversation, and in this market those are not correlated. An
  /// eight-agent firm running heavy portal and Meta spend consumed more
  /// than a forty-agent firm paying five times as much — 31% gross
  /// margin against 90%.
  ///
  /// The headline stays $70. Only firms past the allowance pay more, so
  /// no existing quote is invalidated and nobody's bill goes down.
  includedPerSeat  Int    @default(60)
  overageFils      BigInt @default(35)
  currency      String @default("AED")

  status        SubStatus @default(TRIALING)
  trialEndsAt   DateTime?
  currentFrom   DateTime
  currentTo     DateTime

  /// Provider references. No card data ever reaches this database.
  providerCustomerId String?
  providerSubId      String?

  /// The customer's tax registration number, for a valid UAE tax invoice.
  trn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  seats    SeatEvent[]
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE     // payment failed, still fully working
  RESTRICTED   // degraded on purpose — see dunning.ts
  CANCELLED
}

/// Append-only seat ledger.
///
/// Seats are not counted at a moment in time, because agents join and
/// leave constantly in this market and a month-end headcount would either
/// overcharge or undercharge everybody. Every change is an event, and the
/// invoice is computed from seat-days.
model SeatEvent {
  id       String   @id @default(cuid())
  orgId    String
  subId    String
  userId   String
  change   Int      // +1 joined, -1 left
  at       DateTime @default(now())
  reason   String?

  subscription Subscription @relation(fields: [subId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
  @@index([subId, at])
}

model Invoice {
  id     String @id @default(cuid())
  orgId  String
  subId  String

  number String @unique
  periodFrom DateTime
  periodTo   DateTime

  /// Seat-days, and the arithmetic that produced the total. Kept so an
  /// invoice can be explained line by line rather than merely presented.
  seatDays     Int
  seatDaysFull Int
  /// Split out so an invoice can be read six months later without
  /// recomputing anything — the allowance may have been renegotiated
  /// since, and a document that changes retrospectively is not a tax
  /// invoice.
  seatFils              BigInt @default(0)
  conversationsAnswered Int    @default(0)
  conversationsIncluded Int    @default(0)
  overageFils           BigInt @default(0)

  subtotalFils BigInt
  vatRateBp    Int    @default(500)  // 5.00% as basis points
  vatFils      BigInt
  totalFils    BigInt

  /// The provider's own id for the charge. Unique, so a webhook that
  /// arrives twice cannot settle the same invoice twice.
  providerRef String? @unique

  status    InvoiceStatus @default(OPEN)
  issuedAt  DateTime      @default(now())
  dueAt     DateTime
  paidAt    DateTime?
  attempts  Int           @default(0)
  lastError String?

  subscription Subscription @relation(fields: [subId], references: [id], onDelete: Cascade)

  @@index([orgId, issuedAt])
}

enum InvoiceStatus { DRAFT OPEN PAID FAILED VOID }

// ------------------------------------------------------------------ jobs

/// A run of a scheduled job. Kept because a job that silently stops
/// running is the same failure mode as everything else in this system —
/// nothing errors, things just quietly stop happening.
model JobRun {
  id       String @id @default(cuid())
  job      String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  state      JobState  @default(RUNNING)
  /// Whatever the job wants to report. Counts, not content.
  result     Json?
  error      String?
  durationMs Int?

  @@index([job, startedAt])
  @@index([state, startedAt])
}

enum JobState { RUNNING SUCCEEDED FAILED SKIPPED }

/// Every payment event we have processed, by the provider's event id.
/// The idempotency key for webhooks — a provider that redelivers finds
/// the row already there and does nothing.
model PaymentEvent {
  id         String   @id @default(cuid())
  providerId String   @unique
  provider   String
  type       String
  invoiceId  String?
  handledAt  DateTime @default(now())
  payload    Json?

  @@index([invoiceId])
}

// ------------------------------------------------------------- alerting

/// An open problem. One row per distinct issue, not one per detection —
/// a check that fires every five minutes must not page every five minutes.
model Alert {
  id       String @id @default(cuid())
  /// Stable across detections of the same problem. What makes dedupe work.
  key      String @unique
  orgId    String?

  severity AlertSeverity
  title    String
  detail   String
  runbook  String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// How many consecutive checks have seen it. Used to suppress flapping.
  seenCount   Int       @default(1)
  notifiedAt  DateTime?
  ackedAt     DateTime?
  ackedBy     String?
  resolvedAt  DateTime?

  @@index([severity, resolvedAt])
  @@index([orgId, resolvedAt])
}

enum AlertSeverity {
  PAGE    // wake somebody — only if a human can fix it now
  TICKET  // business hours
  LOG     // recorded, nobody told
}

// ------------------------------------------------------------ mobile

/// A device that can receive push. One row per install, not per user —
/// an agent with a phone and a tablet gets both, and a wiped phone leaves
/// a dead token that has to be cleaned up rather than retried forever.
model PushDevice {
  id     String @id @default(cuid())
  orgId  String
  userId String

  token    String @unique
  platform DevicePlatform
  /// Expo pushes through its own service; the token format differs from
  /// a raw APNs or FCM one and they are not interchangeable.
  provider String @default("expo")

  appVersion String?
  lastSeenAt DateTime @default(now())
  /// Set when the provider tells us the token is dead. Kept rather than
  /// deleted so a reinstall can be distinguished from a first install.
  failedAt   DateTime?
  failReason String?

  @@index([userId, failedAt])
  @@index([orgId])
}

enum DevicePlatform { IOS ANDROID }

// ---------------------------------------------------------------- money
//
// **Every money value in this schema is BigInt fils.** 1 AED = 100 fils.
//
// Not Decimal, and not a mix. Integer fils is what the commission
// arithmetic depends on — splits are computed as basis points and the
// remainder is allocated so the parts sum exactly to the whole, which
// only works on integers.
//
// The earlier version had Lead.budgetMax and Listing.price as Decimal AED
// while everything else was fils. Nothing converted between them, because
// nothing yet joined the two. The first thing to join them would have been
// out by a hundred, and it would have shown a buyer a property ten times
// their budget.
//
// One unit. Format with `aed()` from lib/money.ts and nothing else.

// ----------------------------------------------------------- commission

/// A transaction that pays somebody. Separate from Lead because one lead
/// can produce several deals over years, and a deal can have two sides.
model Deal {
  id     String @id @default(cuid())
  orgId  String
  leadId String?
  listingId String?

  reference String
  type      DealType
  /// The property price. Commission is derived from it, never typed in
  /// separately — two numbers that should agree eventually will not.
  valueFils BigInt
  currency  String @default("AED")

  /// Which side we acted for. In Dubai a brokerage is often on one side
  /// only, and the commission differs.
  side      DealSide @default(SELLER)

  stage       DealStage @default(AGREED)
  /// Cash and mortgage are materially different transactions — different
  /// steps, and roughly three weeks' difference in how long they take.
  financing   Financing @default(UNKNOWN)
  /// Whether the seller has a mortgage to discharge. Adds a bank and
  /// two to three weeks, and is the most commonly forgotten dependency.
  sellerHasMortgage Boolean @default(false)

  agreedAt    DateTime?
  /// The completion date in the Form F. Contractual, not aspirational —
  /// missing it can mean forfeiting the deposit, so everything is planned
  /// backwards from here.
  contractualCompletionAt DateTime?
  expectedAt  DateTime?
  completedAt DateTime?
  collapsedAt DateTime?
  collapseReason String?

  commissions Commission[]
  milestones  DealMilestone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, reference])
  @@index([orgId, stage])
  @@index([orgId, expectedAt])
}

enum DealType { SALE RENTAL OFF_PLAN }
enum DealSide { BUYER SELLER BOTH LANDLORD TENANT }

/// The stages after the handshake. This is where deals actually die, and
/// where the pipeline used to simply stop at "Won".
enum DealStage {
  AGREED            // terms agreed, nothing signed
  MOU_SIGNED        // Form F executed — the contractual clock starts here
  DEPOSIT_PAID
  MORTGAGE_APPLIED  // mortgage path only
  VALUATION_DONE    // mortgage path only
  FINAL_OFFER       // mortgage path only
  LIABILITY_LETTER  // when the seller has a mortgage to discharge
  NOC_APPLIED       // developer NOC
  NOC_RECEIVED
  TRANSFER_BOOKED   // DLD trustee appointment
  COMPLETED         // transferred, title issued
  COLLAPSED
}

/// The brokerage's commission on a deal, before it is split.
model Commission {
  id     String @id @default(cuid())
  orgId  String
  dealId String

  /// Basis points of the deal value. 200 = 2%, the Dubai norm.
  rateBp     Int
  grossFils  BigInt
  /// UAE VAT on the commission itself, which brokerages routinely forget
  /// until an invoice is rejected.
  vatFils    BigInt
  netFils    BigInt

  status     CommissionStatus @default(FORECAST)
  invoicedAt DateTime?
  receivedAt DateTime?

  deal   Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  splits CommissionSplit[]

  @@index([orgId, status])
}

enum CommissionStatus { FORECAST INVOICED RECEIVED WRITTEN_OFF }

/// Who gets what. Several rows per commission — listing agent, selling
/// agent, referrer, and whatever the brokerage keeps.
model CommissionSplit {
  id           String @id @default(cuid())
  orgId        String
  commissionId String

  userId String?
  /// For an external referrer who is not a user.
  externalName String?
  role   SplitRole

  /// Basis points of the net commission. Splits must total 10,000.
  shareBp   Int
  amountFils BigInt

  paidAt   DateTime?
  paidRef  String?

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, paidAt])
}

enum SplitRole { LISTING_AGENT SELLING_AGENT REFERRER MANAGER BROKERAGE }

/// Per-agent commission terms. Tiered, because most brokerages here pay a
/// rising share once an agent passes a threshold.
model CommissionPlan {
  id     String @id @default(cuid())
  orgId  String
  userId String

  /// Ordered bands. Below the first threshold the agent gets the first
  /// share; past it, the next; and so on.
  tiers Json

  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  @@index([orgId, userId, effectiveFrom])
}

// ------------------------------------------------------------------ AML

/// Customer due diligence. A legal obligation, not a feature: every
/// brokerage concluding a sale is a DNFBP under UAE AML law.
model KycRecord {
  id     String @id @default(cuid())
  orgId  String
  leadId String  @unique

  subjectType SubjectType @default(INDIVIDUAL)
  legalName   String
  nationality String?
  /// For a company: the trade licence and the beneficial owners behind it.
  tradeLicence String?

  idType     IdDocType?
  idNumber   String?
  idExpiresAt DateTime?

  /// Where the money comes from, and how it was earned. Two different
  /// questions, and the guidance is explicit that both are required.
  sourceOfFunds  String?
  sourceOfWealth String?

  riskRating   RiskRating @default(UNASSESSED)
  riskReasons  String[]   @default([])
  /// Politically exposed person. Triggers enhanced due diligence.
  isPep        Boolean    @default(false)

  status       KycStatus @default(NOT_STARTED)
  completedAt  DateTime?
  completedById String?
  /// Re-checked periodically. High risk clients more often.
  reviewDueAt  DateTime?

  documents  KycDocument[]
  screenings Screening[]
  ubos       UltimateBeneficialOwner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, riskRating])
  @@index([orgId, reviewDueAt])
}

enum SubjectType { INDIVIDUAL COMPANY TRUST }
enum IdDocType { PASSPORT EMIRATES_ID GCC_ID TRADE_LICENCE }
enum RiskRating { UNASSESSED LOW MEDIUM HIGH }
enum KycStatus { NOT_STARTED COLLECTING PENDING_REVIEW APPROVED REJECTED EXPIRED }

/// The natural person behind a corporate buyer. The whole point of the
/// obligation — shell companies are the mechanism it exists to catch.
model UltimateBeneficialOwner {
  id     String @id @default(cuid())
  orgId  String
  kycId  String

  fullName    String
  nationality String?
  ownershipBp Int?
  idType      IdDocType?
  idNumber    String?

  kyc        KycRecord   @relation(fields: [kycId], references: [id], onDelete: Cascade)
  screenings Screening[]

  @@index([orgId, kycId])
}

model KycDocument {
  id     String @id @default(cuid())
  orgId  String
  kycId  String

  type      IdDocType
  /// Pointer into object storage. The file never lives in Postgres.
  storageRef String
  fileName   String
  expiresAt  DateTime?
  /// How it arrived. Most will say WHATSAPP.
  collectedVia String   @default("WHATSAPP")
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime @default(now())

  kyc KycRecord @relation(fields: [kycId], references: [id], onDelete: Cascade)

  @@index([orgId, expiresAt])
}

/// Sanctions and PEP screening. Required before onboarding, and repeated —
/// lists change, and a client who was clear in March may not be in June.
model Screening {
  id     String @id @default(cuid())
  orgId  String
  kycId  String?
  uboId  String?

  nameChecked String
  /// UAE Local Terrorist List, UN Consolidated, and the provider's PEP set.
  lists       String[]
  provider    String
  result      ScreeningResult
  matches     Json?
  screenedAt  DateTime @default(now())
  clearedById String?
  clearedNote String?

  kyc KycRecord               @relation(fields: [kycId], references: [id], onDelete: Cascade)
  ubo UltimateBeneficialOwner? @relation(fields: [uboId], references: [id], onDelete: Cascade)

  @@index([orgId, result, screenedAt])
}

enum ScreeningResult { CLEAR POSSIBLE_MATCH CONFIRMED_MATCH ERROR }

/// A filing, or a decision not to file. Both matter — an inspector asks
/// why you did not report as often as why you did.
///
/// Visibility is restricted to the compliance officer. Telling the client
/// a report was filed is "tipping off" and is an offence in itself, so
/// the agent handling the deal must not be able to see this.
model ComplianceReport {
  id     String @id @default(cuid())
  orgId  String
  dealId String?
  kycId  String?

  type       ReportType
  /// Why it was triggered, in the compliance officer's words.
  rationale  String
  /// Cash amount that triggered a REAR, in fils.
  cashFils   BigInt?
  filedAt    DateTime?
  /// The goAML reference once submitted.
  goamlRef   String?
  decidedById String
  decidedAt   DateTime @default(now())
  /// Set when a review concluded no filing was needed. Recorded, because
  /// a decision not to file is a decision.
  notFiledReason String?

  @@index([orgId, type, decidedAt])
}

enum ReportType {
  REAR   // Real Estate Activity Report — cash at or above the threshold
  STR    // Suspicious Transaction Report
  SAR    // Suspicious Activity Report
  CNMR   // Confirmed Name Match Report
  FFR    // Fund Freeze Report
  NO_FILING
}

enum Financing { UNKNOWN CASH MORTGAGE }

/// One row per step in the transaction. A row rather than a status field
/// because the useful questions are "when was this done, by whom, and
/// what is attached" — none of which a single enum can answer.
model DealMilestone {
  id     String @id @default(cuid())
  orgId  String
  dealId String

  stage      DealStage
  /// Planned backwards from the contractual completion date.
  dueAt      DateTime?
  completedAt DateTime?
  completedById String?

  /// Set when this step slipped past its planned date. Kept after the
  /// fact, because a deal that completed late still teaches you where the
  /// process is slow.
  slippedByDays Int?
  blockedReason String?
  note          String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, stage])
  @@index([orgId, dueAt, completedAt])
}

// ----------------------------------------------------------- requirements

/// What a buyer is actually looking for.
///
/// A record rather than fields on the lead, because one person routinely
/// wants two different things — "a two-bed to live in, or a studio to let
/// out" — and a single set of columns cannot hold that without lying
/// about one of them.
model Requirement {
  id     String @id @default(cuid())
  orgId  String
  leadId String

  label   String?
  purpose Purpose @default(SALE)
  intent  Intent?

  budgetMinFils BigInt?
  budgetMaxFils BigInt?

  /// Must-haves disqualify. Nice-to-haves only move the score. Keeping
  /// them apart is what stops a system sending a one-bed to somebody who
  /// said three and calling it a "partial match".
  bedroomsMin Int?
  bedroomsMax Int?
  areaMinSqft Int?

  /// Alternatives, not a single value. "Marina or JBR" is one
  /// requirement, not two.
  communities String[] @default([])
  /// Free text, scored loosely. Sea view, high floor, furnished.
  preferences String[] @default([])

  /// Where this came from, and how much to trust it.
  source     RequirementSource @default(ASSISTANT)
  /// The assistant's confidence when it inferred this. Below the floor,
  /// it informs an agent and never triggers an outbound message.
  confidence Float?
  confirmedById String?
  confirmedAt   DateTime?

  active    Boolean   @default(true)
  /// Requirements go stale. Somebody looking six months ago has usually
  /// bought — from us or from somebody else.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, active, expiresAt])
  @@index([orgId, leadId])
}

enum RequirementSource {
  ASSISTANT   // inferred from conversation
  AGENT       // typed in by a person
  LEAD        // stated explicitly and unambiguously
}

// -------------------------------------------------------- lead ownership

/// How new leads are routed. Per brokerage, because every one of them has
/// a different opinion and all of them feel strongly about it.
model AssignmentRule {
  id     String @id @default(cuid())
  orgId  String

  name     String
  priority Int
  active   Boolean @default(true)

  /// Conditions. All must match. Empty means it always matches, which is
  /// what makes the lowest-priority rule the fallback.
  sources     LeadSource[] @default([])
  communities String[]     @default([])
  languages   String[]     @default([])
  minBudgetFils BigInt?
  maxBudgetFils BigInt?

  strategy AssignStrategy @default(ROUND_ROBIN)
  /// The pool. Empty means everyone with the AGENT role.
  userIds  String[] @default([])

  @@index([orgId, active, priority])
}

enum AssignStrategy {
  ROUND_ROBIN     // fair, and visibly so
  LEAST_LOADED    // by open leads
  FASTEST         // by median first-response time
  SPECIFIC        // always this person
  UNASSIGNED      // deliberately nobody — a shared pool anyone can claim
}

/// Every change of hands, kept forever.
///
/// The point is not the current owner — that is a field on the lead. The
/// point is being able to answer "who had this, when, and who moved it"
/// without anybody's memory being involved.
model LeadOwnership {
  id     String @id @default(cuid())
  orgId  String
  leadId String

  userId    String?
  fromUserId String?
  reason    OwnershipReason
  ruleId    String?
  /// Who made the change, when a person did.
  actorId   String?
  note      String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([orgId, leadId, startedAt])
  @@index([orgId, userId, endedAt])
}

enum OwnershipReason {
  FIRST_ASSIGNMENT
  RULE
  MANUAL
  CLAIMED          // taken from the shared pool
  PROTECTION       // returning enquirer, still inside the window
  PROTECTION_LAPSED
  REASSIGNED       // manager moved it
  AGENT_LEFT
}

/// Agent availability. Routing to somebody on leave is how a lead sits
/// unanswered for three days while the system reports it as assigned.
model AgentAvailability {
  id     String @id @default(cuid())
  orgId  String
  userId String

  acceptingLeads Boolean @default(true)
  /// Soft cap on open leads. Past it, routing skips them rather than
  /// piling on — a lead nobody has time for is worse than one in a pool.
  capacity       Int     @default(40)

  awayFrom DateTime?
  awayTo   DateTime?
  awayNote String?

  languages   String[] @default([])
  communities String[] @default([])

  @@unique([orgId, userId])
}

// ------------------------------------------------------------- documents

/// One store for everything with an expiry date.
///
/// Written after noticing the same idea had grown in three places:
/// `KycDocument`, the permit fields on `Listing`, and the `requires` list
/// on a deal milestone. Three implementations of "a file that expires and
/// somebody needs telling about" is two too many, and the third one is
/// always the one nobody wired up to an alert.
///
/// KycDocument stays as it is — an AML file has its own retention rules
/// and its own access controls, and folding it in here would weaken both.
model Document {
  id     String @id @default(cuid())
  orgId  String

  /// What it belongs to. Polymorphic because the same document type
  /// hangs off different things: a title deed off a listing, a RERA card
  /// off a user, a trade licence off the organisation.
  ownerType DocumentOwner
  ownerId   String

  type     DocumentType
  fileName String
  /// Object storage. Never the file itself.
  storageRef String
  sizeBytes  Int?
  mimeType   String?

  issuedAt  DateTime?
  expiresAt DateTime?
  /// Set once somebody has actually looked at it. A stored document is
  /// not a verified one.
  verifiedAt   DateTime?
  verifiedById String?

  uploadedById String?
  uploadedVia  String   @default("WEB")
  supersededById String?

  createdAt DateTime @default(now())

  /// Covers the expiry sweep, which is the only query that runs often.
  @@index([orgId, expiresAt, supersededById])
  @@index([orgId, ownerType, ownerId])
}

enum DocumentOwner { LEAD LISTING DEAL USER ORGANISATION }

enum DocumentType {
  // Client
  PASSPORT
  EMIRATES_ID
  VISA
  TRADE_LICENCE
  // Property
  TITLE_DEED
  NOC
  SERVICE_CHARGE_CLEARANCE
  EJARI
  TENANCY_CONTRACT
  FORM_F
  SPA
  FLOOR_PLAN
  // Agent and brokerage
  RERA_BROKER_CARD
  BROKERAGE_LICENCE
  TRAKHEESI_PERMIT
  OTHER
}

// ------------------------------------------------------------ task plans

/// A sequence a contact is put on.
///
/// The gap this fills: a lead who says "we're looking in about six
/// months" is currently a note in a field, and a note does nothing. In
/// this market a meaningful share of enquiries are six to twelve months
/// out, and the agency still politely in touch at month five wins them.
model TaskPlan {
  id     String @id @default(cuid())
  orgId  String

  name        String
  description String?
  /// What kind of contact this is for. A seller nurture and a buyer
  /// nurture are not the same sequence with different words.
  audience    PlanAudience
  active      Boolean @default(true)

  steps         PlanStep[]
  subscriptions PlanSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
}

enum PlanAudience { BUYER SELLER LANDLORD TENANT PAST_CLIENT }

model PlanStep {
  id     String @id @default(cuid())
  orgId  String
  planId String

  order    Int
  /// Days after the previous step. The first step is days after
  /// subscription.
  afterDays Int

  action   PlanAction
  /// For MESSAGE: the template name, because these are almost always
  /// outside the 24-hour window.
  template String?
  /// For TASK: what the agent is being asked to do, in their words.
  taskTitle String?
  note      String?

  plan TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, order])
}

enum PlanAction {
  MESSAGE       // the assistant sends, on WhatsApp
  TASK          // an agent is asked to do something
  CHECK_MATCHES // run the matcher and message only if something fits
  REVIEW        // prompt to decide whether to keep going
}

/// One contact on one plan.
model PlanSubscription {
  id     String @id @default(cuid())
  orgId  String
  planId String
  leadId String

  state     SubscriptionState @default(RUNNING)
  currentStep Int    @default(0)
  nextDueAt  DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Why it stopped. "They replied" is the good ending and the most
  /// common one — a plan that runs to completion usually means nobody
  /// engaged.
  endedReason String?

  plan TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([leadId, planId])
  @@index([orgId, state, nextDueAt])
}

enum SubscriptionState {
  RUNNING
  PAUSED        // the lead replied — a human has it now
  COMPLETED
  STOPPED       // opted out, or an agent ended it
}

// -------------------------------------------------------------- feedback

/// What a buyer thought, collected from the buyer rather than
/// reconstructed from the agent's memory a week later.
model ViewingFeedback {
  id     String @id @default(cuid())
  orgId  String
  viewingId String @unique
  leadId    String
  listingId String?

  /// One question, tapped. A survey gets five percent; one question with
  /// four buttons gets most people.
  verdict   Verdict?
  /// Structured reasons, from a short list, so they can be counted across
  /// viewings. Free text cannot be aggregated into anything useful.
  reasons   FeedbackReason[] @default([])
  /// Anything they typed. Never shown to the vendor verbatim — see the
  /// report module for why.
  comment   String?

  askedAt    DateTime?
  answeredAt DateTime?
  /// Collected by the assistant, or typed in by the agent after a call.
  source     String @default("WHATSAPP")

  createdAt DateTime @default(now())

  @@index([orgId, listingId, answeredAt])
}

enum Verdict {
  OFFERING          // wants to make an offer
  INTERESTED        // wants a second viewing or time to think
  NOT_FOR_ME
  WRONG_PROPERTY    // it was not what they expected from the listing
}

enum FeedbackReason {
  PRICE_TOO_HIGH
  TOO_SMALL
  LAYOUT
  CONDITION
  LOCATION
  VIEW
  NOISE
  PARKING
  SERVICE_CHARGE
  NOT_AS_ADVERTISED
  BUYING_ELSEWHERE
  OTHER
}

/// A report sent to the owner. Recorded because "have we updated the
/// vendor" is a question every brokerage answers badly.
model VendorReport {
  id     String @id @default(cuid())
  orgId  String
  listingId String

  periodFrom DateTime
  periodTo   DateTime
  viewings   Int
  offers     Int
  /// The counted reasons, so the report is evidence rather than opinion.
  summary    Json
  /// Set when the numbers say the price is the problem.
  priceSignal String?

  sentAt   DateTime?
  sentVia  String?

  createdAt DateTime @default(now())

  @@index([orgId, listingId, createdAt])
}

// ------------------------------------------------------------- migration

/// One attempt at moving a brokerage off whatever they were using.
///
/// A record rather than a script run, because a migration is not an
/// event — it is a fortnight during which two systems are both live and
/// somebody needs to be able to answer "where are we".
model Migration {
  id     String @id @default(cuid())
  orgId  String

  source      String   // "PropSpace", "Goyzer", "spreadsheet", "Reapit"
  state       MigrationState @default(DRAFT)

  /// Everything lands here first and is counted before anything is
  /// written into the live tables.
  stagedCounts Json?
  /// What the source said it had. The two are compared, and a difference
  /// is shown rather than resolved.
  claimedCounts Json?

  /// Where the export lives, so a rollback has something to go back to.
  sourceArchiveRef String?

  startedAt   DateTime  @default(now())
  cutoverAt   DateTime?
  completedAt DateTime?
  abandonedAt DateTime?
  abandonReason String?

  issues MigrationIssue[]

  @@index([orgId, state])
}

enum MigrationState {
  DRAFT       // mapping being agreed
  STAGED      // loaded, counted, not yet live
  RECONCILED  // the brokerage has checked and signed off
  PARALLEL    // live here, still live there
  COMPLETE
  ABANDONED
}

/// Something wrong with the incoming data. Surfaced, never silently
/// fixed — a migration that quietly tidies somebody's database is a
/// migration they cannot trust.
model MigrationIssue {
  id          String @id @default(cuid())
  orgId       String
  migrationId String

  severity  IssueSeverity
  kind      String
  entity    String
  /// The source's own identifier, so they can go and look at it.
  sourceRef String?
  detail    String
  /// What we propose. Null when there is no safe default and a person
  /// has to choose.
  suggestion String?
  decision   String?
  decidedById String?

  migration Migration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  @@index([migrationId, severity])
}

enum IssueSeverity {
  BLOCKER   // cannot import this record at all
  DECISION  // needs a human to choose
  NOTE      // imported, worth knowing
}

/// A file sent to a lead, or received from one.
///
/// Agents send brochures, floor plans and payment plans constantly. With
/// no way to attach one, the first time a buyer asks the agent leaves
/// for WhatsApp — and does not come back for the next thing either.
model Attachment {
  id     String @id @default(cuid())
  orgId  String
  messageId String?
  /// Reusable library items — a brochure attached to a listing, sendable
  /// to any lead without re-uploading.
  listingId String?

  kind      AttachmentKind
  fileName  String
  /// Object storage. The file never lives in Postgres.
  storageRef String
  mimeType   String
  sizeBytes  Int

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([orgId, listingId])
  @@index([messageId])
}

enum AttachmentKind {
  BROCHURE
  FLOOR_PLAN
  PAYMENT_PLAN
  PHOTO
  DOCUMENT
  OTHER
}

/// One attempt at a rate-limited action.
///
/// Not tenant-scoped — it exists precisely for requests that arrive
/// before a tenant is known. Swept daily; without that it becomes the
/// largest table in the database, which is a silly way to run out of
/// disk.
model RateLimitHit {
  id     String   @id @default(cuid())
  action String
  key    String
  at     DateTime @default(now())

  @@index([action, key, at])
  @@index([at])
}

/// The person who instructed us. The other half of every deal.
///
/// Absent until day one of a twenty-two-year agent, who found the
/// VendorReport model we had already built and asked the obvious
/// question: **there is nobody to send it to.**
///
/// Not folded into Lead. A lead enquired; a vendor employed us, and
/// conflating them means every filter, report and routing rule has to
/// remember which is which.
model Vendor {
  id    String @id @default(cuid())
  orgId String

  name  String
  phone String?
  email String?

  /// How they want to hear from us. Getting this wrong is the fastest
  /// way to lose an instruction — some owners want a call every
  /// Thursday, some want nothing until there is an offer.
  prefers    ContactPreference @default(WHATSAPP)
  reportDay  Int?              @default(4)
  reportsOff Boolean           @default(false)

  /// An owner who is not the seller — a power of attorney, a family
  /// member handling it, a company representative. Common here.
  actingFor  String?

  /// Stops two agents telling one vendor two different stories about
  /// the same week.
  lastReportedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, phone])
}

enum ContactPreference {
  WHATSAPP
  CALL
  EMAIL
  /// A real instruction some owners give. Ignoring it loses the
  /// property.
  OFFERS_ONLY
}

/// An offer, and everything said after it.
///
/// This is the job. The product's answer to the most important twenty
/// minutes of any deal was a listing status that said UNDER_OFFER.
model Offer {
  id        String @id @default(cuid())
  orgId     String
  listingId String
  leadId    String?
  vendorId  String?
  agentId   String?

  /// Fils. Never a float — see lib/money.ts.
  amountFils BigInt

  financing      Financing @default(UNKNOWN)
  /// A pre-approval in principle is not a mortgage. Recorded separately
  /// because a vendor choosing between two offers is entitled to know
  /// which buyer can actually complete.
  preApproved    Boolean   @default(false)
  preApprovalRef String?

  /// Subject to survey, subject to another sale, a fixed completion
  /// date. The thing that turns a higher offer into a worse one.
  conditions String?

  /// Whether the SELLER has a mortgage on the property.
  ///
  /// The single biggest driver of how long a transfer takes here — a
  /// mortgaged buyer against a mortgaged seller is roughly 47 working
  /// days, and a 30-day Form F is about 22. Captured on the offer
  /// because that is when an agent knows it, and carried onto the deal
  /// so the timeline warning fires before anybody signs.
  sellerHasMortgage Boolean @default(false)

  status    OfferStatus @default(SUBMITTED)
  /// Offers expire. An agent chasing an acceptance on one that lapsed
  /// on Tuesday is an agent about to be embarrassed.
  expiresAt DateTime?

  submittedAt DateTime @default(now())
  decidedAt   DateTime?

  responses OfferResponse[]

  @@index([orgId, listingId, submittedAt])
  @@index([orgId, status])
}

enum OfferStatus {
  SUBMITTED
  /// Shown to the vendor. Distinct from submitted, because "did he see
  /// it?" is the first question a buyer's agent asks.
  PRESENTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  LAPSED
}

/// One turn of the negotiation.
///
/// A counter creates a row; it never edits the amount. Overwriting
/// would erase the negotiation — the one record both sides argue about
/// later, and the one an agent needs when a commission is disputed.
model OfferResponse {
  id      String @id @default(cuid())
  orgId   String
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  by         OfferParty
  kind       OfferResponseKind
  /// Present on a counter, absent on an accept or reject.
  amountFils BigInt?
  note       String?

  /// Who recorded it, which is not the same as who said it.
  recordedById String?
  at           DateTime @default(now())

  @@index([orgId, offerId, at])
}

enum OfferParty { BUYER VENDOR AGENT }
enum OfferResponseKind { COUNTER ACCEPT REJECT WITHDRAW QUERY }

/// One billable conversation.
///
/// A conversation is billable when the assistant answered an inbound
/// enquiry — not when a message was sent, and not when a lead was
/// created.
///
/// That definition is the whole thing, so it is worth being exact:
///
///   - A buyer messaging twice in one day is **one** conversation. A
///     brokerage billed twice for one buyer having second thoughts would
///     be right to leave.
///   - An agent replying by hand is **not** billable. We charge for work
///     the product did, not for hosting a message box.
///   - A proactive nudge the buyer never answers is **not** billable.
///     Charging for an unanswered message is charging for failure.
///
/// Recorded per conversation per UTC day, so the unique constraint does
/// the deduplication rather than application logic that can drift.
model ConversationCharge {
  id     String @id @default(cuid())
  orgId  String
  subId  String

  conversationId String
  /// The UTC day, truncated. The natural key for "once per day".
  day            DateTime

  createdAt DateTime @default(now())

  @@unique([conversationId, day])
  @@index([orgId, subId, day])
}

/// An agent's blackbook entry.
///
/// The competing product sells "your blackbook" to the agent, and the
/// agent takes it with them when they change firm. That is honest to
/// the agent and it means the brokerage's system of record is a record
/// of nothing.
///
/// **This splits the two.** The relationship layer is the agent's — their
/// notes, their nicknames, their sense of who this person is — and it
/// exports with them. The transaction layer stays with the brokerage:
/// the deal, the offer, the KYC file, the audit trail.
///
/// Neither party is being quietly done over, which is the only version
/// of this that survives an agent actually leaving.
model BlackbookEntry {
  id      String @id @default(cuid())
  orgId   String
  agentId String

  /// The person, wherever they already exist in the system. A blackbook
  /// entry is a VIEW of somebody, not a second copy of them — a
  /// duplicate contact store is how a CRM starts lying to itself.
  leadId   String?
  vendorId String?

  /// Somebody who is neither yet. An agent's book is full of people who
  /// have not enquired about anything: a mortgage broker, a conveyancer,
  /// a developer's sales manager.
  standaloneName  String?
  standalonePhone String?
  standaloneEmail String?

  /// What the agent calls them, which is often not their legal name.
  nickname String?
  /// Free text. Theirs, exports with them, never shown to a manager.
  privateNote String?
  /// "mortgage broker", "Emaar", "school run friend" — an agent's own
  /// taxonomy, not the brokerage's pipeline stages.
  tags String[]

  starred     Boolean   @default(false)
  lastTouched DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, leadId])
  @@unique([agentId, vendorId])
  @@index([orgId, agentId, lastTouched])
}

/// A mailbox an agent has connected.
///
/// Tokens live in the secret store, never here — the same rule the
/// WhatsApp channel follows.
model EmailAccount {
  id      String @id @default(cuid())
  orgId   String
  agentId String

  provider  EmailProvider
  address   String
  secretRef String

  /// Where the last sync got to. Providers give a cursor; storing it
  /// means a resync fetches the delta rather than the mailbox.
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([agentId, address])
  @@index([orgId, active])
}

enum EmailProvider { GOOGLE MICROSOFT }

/// One email, reduced to what a CRM actually needs.
///
/// Headers, a snippet and the participants — **not the body**. Storing
/// full message bodies makes this a mail archive, which is a different
/// product with different retention obligations and a much worse
/// breach story. The body stays in the mailbox; we keep enough to show
/// a timeline and to open the original.
model EmailMessage {
  id        String @id @default(cuid())
  orgId     String
  accountId String

  externalId String
  threadId   String
  direction  Direction

  fromAddress String
  toAddresses String[]
  subject     String?
  /// First ~200 characters. Enough to recognise the message in a list.
  snippet     String?

  /// Matched to a person, if we could. Null is normal and fine.
  leadId   String?
  vendorId String?

  sentAt   DateTime
  /// A link back to the message in Gmail or Outlook.
  webLink  String?

  @@unique([accountId, externalId])
  @@index([orgId, leadId, sentAt])
  @@index([orgId, threadId])
}

/// A spoken or typed request from an agent.
///
/// The competing model puts a human advisor in every loop to check the
/// output before it goes back. That caps throughput at headcount and
/// adds hours of latency.
///
/// We use a **confidence gate** instead: the work is produced in
/// seconds, and where the evidence is thin the deliverable says so in
/// its own words rather than a person catching it later. A number an
/// agent shows a seller is a number they get held to — being fast is
/// worth nothing if it is wrong.
model AgentRequest {
  id      String @id @default(cuid())
  orgId   String
  agentId String

  /// What they actually said or typed, kept verbatim. When a recipe is
  /// classified wrongly this is the only way to find out why.
  transcript String
  /// Present when it arrived as audio.
  audioRef   String?

  recipe     Recipe
  /// How sure the classifier was. Below the floor we ask rather than guess.
  confidence Float

  /// What it needs and what it found. A request naming a listing we do
  /// not hold is answerable — but only by saying so.
  listingId String?
  leadId    String?
  vendorId  String?

  state    RequestState @default(QUEUED)
  /// The finished thing, or the reason there isn't one.
  outputRef String?
  /// Stated on the deliverable itself, never only in a log.
  caveats   String[]

  /// Escalated to a person. Rare by design, and always for a named
  /// reason — never "the model was unsure" with nothing after it.
  escalatedTo     String?
  escalationReason String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([orgId, agentId, createdAt])
  @@index([orgId, state])
}

/// The recipes. Deliberately a closed set.
///
/// The competing product runs 17 and calls them recipes. An open-ended
/// "ask for anything" surface produces confident nonsense at the edges,
/// and in this domain the edges are where somebody gets sued.
enum Recipe {
  /// The CMA equivalent. Dubai has no MLS, so this is built from DLD
  /// transactions plus the brokerage's own completed deals.
  COMPARABLES
  /// A pitch for an instruction, using real viewing and offer activity.
  LISTING_PITCH
  /// This week for one owner. Already exists as a job; now callable.
  VENDOR_UPDATE
  /// Log a person met, with the follow-up already scheduled.
  LOG_CONTACT
  /// A viewing, from "book Tuesday afternoon at the Marina flat".
  BOOK_VIEWING
  /// Message a lead, respecting the reply window.
  DRAFT_REPLY
  /// What is happening today, spoken back.
  DAY_BRIEF
  /// Anything else — asked about rather than guessed at.
  UNCLEAR
}

enum RequestState {
  QUEUED
  RUNNING
  DONE
  /// Could not be done, with a reason the agent can act on.
  REFUSED
  /// Handed to a person.
  ESCALATED
}

/// A personal follow-up. "Ring Rashid on Thursday."
///
/// There was no model for this. `TaskPlan` is a sequence template
/// applied to a pipeline, and `DealMilestone` belongs to a transaction —
/// neither is "remind me about this person".
///
/// Added because the spoken-request flow promises a reminder when an
/// agent logs somebody they met, and a promise with nowhere to store it
/// is a lie in the interface.
model FollowUp {
  id      String @id @default(cuid())
  orgId   String
  agentId String

  title String
  /// Usually the agent's own words from the voice note. Better than
  /// anything generated from them.
  body  String?

  /// What it is about, where there is something.
  leadId          String?
  vendorId        String?
  blackbookEntryId String?

  dueAt       DateTime
  completedAt DateTime?
  /// Set when the reminder actually went out, so a restart does not
  /// send it twice.
  notifiedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, agentId, dueAt, completedAt])
  @@index([orgId, dueAt, notifiedAt])
}
