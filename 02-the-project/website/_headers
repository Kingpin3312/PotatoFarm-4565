/*
  # The static site. Tighter than the application's, because this one has
  # no third-party anything except the font — which is the one thing here
  # worth removing later, since rsms.me sees every visitor's IP and the
  # privacy page is two clicks away.
  # connect-src carries app.potatofarm.io because the demo and guide
  # forms fetch the application's API — this site has no server of its
  # own. form-action deliberately does NOT: with JavaScript off, a native
  # post would land the visitor on a page of raw JSON, and the mailto
  # link beside every form is the better fallback.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://rsms.me; font-src 'self' https://rsms.me; img-src 'self' data:; connect-src 'self' https://app.potatofarm.io; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/assets/*
  Cache-Control: public, max-age=31536000, immutable
