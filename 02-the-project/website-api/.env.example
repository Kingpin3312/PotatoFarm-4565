# ---- Email (Resend) ----
RESEND_API_KEY=
MAIL_FROM="PotatoFarm.io <hello@potatofarm.io>"
SALES_INBOX=hello@potatofarm.io

# ---- Spam (Cloudflare Turnstile) ----
# Leave blank in development. If blank in production the check is skipped
# and a warning is logged - do not ship without these set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Rate limiting (optional but recommended) ----
# Without these, limiting is per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- CRM ----
CRM_ENDPOINT=
CRM_API_KEY=

# ---- Generic webhook (Zapier, Make, n8n, your own) ----
LEAD_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=

# ---- Analytics ----
NEXT_PUBLIC_GA_ID=
